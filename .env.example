NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave Turso values unset to use the local SQLite database during development.
# For Turso, set both server-only variables to the exact URL and token from Turso.
# DATABASE_URL=libsql://your-database-your-org.turso.io
# DATABASE_TOKEN=replace-with-your-turso-auth-token

# Optional comma-separated hostname allowlist for media URLs.
# MEDIA_ALLOWED_HOSTS=images.example.com,cdn.example.com

# For local Vercel Blob uploads, use a server-only development token.
# In a linked Vercel deployment, connect a Blob store to the project.
# BLOB_READ_WRITE_TOKEN=replace-with-your-blob-read-write-token
